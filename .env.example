# Copy to .env and adjust as needed. `docker-compose.yml` provisions a
# matching local PostgreSQL instance.

# --- Database (shared by api, worker, fake-charge) ---
DATABASE_URL=postgres://reliableq:reliableq@localhost:5432/reliableq
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT_SECS=5

# --- Logging ---
# json | pretty
LOG_FORMAT=pretty

# --- reliableq-api ---
API_BIND_ADDR=0.0.0.0:8080
API_MAX_BODY_BYTES=65536
API_REQUEST_TIMEOUT_SECS=10

# --- fake-charge ---
FAKE_CHARGE_BIND_ADDR=0.0.0.0:8081
FAKE_CHARGE_MAX_BODY_BYTES=65536
FAKE_CHARGE_REQUEST_TIMEOUT_SECS=10

# --- reliableq-worker (used from M1 onward) ---
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=250
WORKER_LEASE_DURATION_SECS=30
WORKER_CHARGE_SERVICE_URL=http://localhost:8081
